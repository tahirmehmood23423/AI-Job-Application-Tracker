# ===== LLM Provider Configuration =====
# Choose ONE provider. The service auto-detects which one is available.
# Gemini is the default because it has a generous FREE tier.

# Which provider to use: "gemini" (free), "anthropic", or "openai"
LLM_PROVIDER=gemini

# Google Gemini (FREE — recommended)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic (best quality, paid)
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (paid, alternative)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== Server Configuration =====
APP_ENV=development         # development | production
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
PORT=8000

# ===== Limits =====
MAX_FILE_SIZE_MB=10
MAX_TEXT_LENGTH=50000       # Maximum characters of resume text to send to LLM
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ===== CORS (for when the dashboard frontend connects) =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
